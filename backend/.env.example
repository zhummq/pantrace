# ===== 上游（唯一通道：idatariver 控制台 MAPI）=====
# 鉴权只认 x-idr-sign 这一个请求头，实测不带任何 cookie 也能通。
# 签名会过期，过期后返回 code 1004，需要在浏览器重新抓一份填进来：
#   控制台做一次搜索 → F12 → Network → 该请求 → 复制 x-idr-sign 和 x-idr-time
IDR_URL=https://user.idatariver.com/api/user/app/mapi
IDR_SIGN=v1:B94662E2A66130DB765BB16643EBE44E
IDR_TIME=1794319034248

# apikey 由后端拼进上游请求体，前端永远拿不到
API_KEY=idr_aba39993bb4df97a5bbd7853c67144f8

# ===== 超时 =====
# 上游要求超时 > 60 秒，否则中途断开照样计费
REQUEST_TIMEOUT=75
# 连接超时单独设：上游走 Cloudflare，TLS 握手实测就要 4 秒
CONNECT_TIMEOUT=25

# ===== 网络 =====
# 默认直连上游，不读系统 http_proxy（走本机代理实测更慢且会超时）
USE_ENV_PROXY=false
PROXY_URL=

# ===== 服务 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PAGE_SIZE=50
SERVE_FRONTEND=true

# ===== 用户行为埋点 =====
# 数据只落本地 SQLite（backend/data/analytics.db），不外发、不上报第三方。
ANALYTICS_ENABLED=true
# 报表按哪个时区切天。服务器是 UTC 时保持 8 即可看到北京时间口径
ANALYTICS_TZ_OFFSET=8
# 保留天数，超期自动删，防止库无限长大
ANALYTICS_RETAIN_DAYS=180
# 单 IP 每分钟最多上报多少条事件，防刷
ANALYTICS_RATE_PER_MINUTE=120

# ===== 反馈 / 求资源 =====
# 和埋点共用 backend/data/analytics.db 里的 feedback 表。
# 关掉不影响埋点，反之亦然。
FEEDBACK_ENABLED=true
# 单 IP 十分钟提交上限。只对通过校验的提交计数
FEEDBACK_RATE_PER_10MIN=5

# ===== 看板口令 =====
# 访问 /admin 看数据要输这个口令。留空时只有本机能看（走 Nginx 反代后等于谁都进不去）。
# 部署到公网必须设一个，建议 16 位以上随机串。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(18))"
ADMIN_TOKEN=
