# ===== 上游（唯一通道：idatariver 控制台 MAPI）=====
# 鉴权只认 x-idr-sign 这一个请求头，实测不带任何 cookie 也能通。
# 签名会过期，过期后返回 code 1004，需要在浏览器重新抓一份填进来：
#   控制台做一次搜索 → F12 → Network → 该请求 → 复制 x-idr-sign 和 x-idr-time
IDR_URL=https://user.idatariver.com/api/user/app/mapi
IDR_SIGN=v1:你的签名_浏览器F12抓取
IDR_TIME=

# apikey 由后端拼进上游请求体，前端永远拿不到
API_KEY=idr_你的apikey_控制台获取

# ===== 搜索源（插件层）=====
# 逗号分隔的插件名，**空 = 一个源都不启用**（pansou 的约定：新源必须显式批准）。
#   tg_searchers TG 公开频道：**基础通道**，免费、无额度
#   haisou       官方 API 通道：**兜底通道**，按平台计费（一次搜索 = 平台数 × 2 页）
# 两个都启用时走分层降级（不是并行）：TG 拿到可用结果就结束，一条额度都不花；
# TG 不可达 / 零结果 / 没有用户要的网盘，才去调 haisou。
# 顺序按语义写 TG 在前，实际分层看插件的 source_kind，不依赖顺序。
# 连不上 t.me 的机器（本机开发、国内机房）可以只留 haisou，等同于"跳过 TG 直接计费"。
# 留空会让 /api/search 直接返回 504。
ENABLED_SOURCES=tg_searchers,haisou

# 用户没选网盘时兜底查哪个盘。**不要退化成全平台**：那等于一次搜索烧掉 5 份额度。
DEFAULT_PLATFORM=quark

# ===== TG 频道 =====
# 只在 ENABLED_SOURCES 里带了 tg_searchers 时才生效。
# 可达性由后台探测循环维护（连续 2 次失败才关门），搜索路径只读结论、不阻塞。
# 本机/国内机房通常连不上 t.me：门关时 TG 会被秒跳过，不影响其他源的结果，
# 也不会写缓存、不计频道失败。启动后看 /api/health 的 tgGate 确认。
# 这里只是**默认值**：/admin 的「TG 频道」保存后会覆盖它且立即生效，不用重启；
# 在后台点「恢复 .env 默认」即可删掉覆盖回到这里。逗号分隔，最多 20 个。
TG_CHANNELS=tgsearchers7

# ===== 超时 =====
# 上游要求超时 > 60 秒，否则中途断开照样计费
REQUEST_TIMEOUT=75
# 连接超时单独设：上游走 Cloudflare，TLS 握手实测就要 4 秒
CONNECT_TIMEOUT=25

# ===== 网络 =====
# 默认直连上游，不读系统 http_proxy（走本机代理实测更慢且会超时）
USE_ENV_PROXY=false
PROXY_URL=

# ===== 服务 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_PAGE_SIZE=50
SERVE_FRONTEND=true

# ===== 防刷（不做账号、不收个人信息）=====
# 搜索结果缓存秒数，同 query 不重复打上游
CACHE_TTL=300
# 单 IP 每分钟请求上限（滑动窗口，领票和搜索共用一个计数池）。
# 正常用户几分钟搜不了 30 次；机器人/脚本才会撞到。默认 30。
RATE_LIMIT_PER_MINUTE=30
# 匿名票据有效期秒数。前端进站静默领票、过期前自动续，用户无感。
TICKET_TTL=300
# 票据 HMAC 密钥。留空则从 API_KEY|IDR_SIGN 派生（重启不变）。
# 主动换掉它 = 所有在途票据立即失效，可用于强制全员重领。
TICKET_SECRET=

# ===== 用户行为埋点 =====
# 数据只落本地 SQLite（backend/data/analytics.db），不外发、不上报第三方。
ANALYTICS_ENABLED=true
# 报表按哪个时区切天。服务器是 UTC 时保持 8 即可看到北京时间口径
ANALYTICS_TZ_OFFSET=8
# 保留天数，超期自动删，防止库无限长大
ANALYTICS_RETAIN_DAYS=180
# 单 IP 每分钟最多上报多少条事件，防刷
ANALYTICS_RATE_PER_MINUTE=120

# ===== 资源库（本地索引） =====
# 影子回填：每次搜索已经拿到的结果顺手落库，不额外打上游、不消耗任何额度。
# 关掉它搜索行为完全不变，只是库不再增长。
LIBRARY_ENABLED=true
# 库文件路径，留空 = backend/data/library.db。和埋点同目录，备份一次全带走
LIBRARY_DB=
# 每天自动把登记的腾讯文档订阅跑一轮增量。关掉只是不自动跑，管理端面板上
# 单表「立即抓取」照旧可用——抓数是 IO 密集的，出问题要能单独停它排障。
LIBRARY_DAILY_SYNC=true
# 服务器本地时间几点跑。默认凌晨 4 点，避开白天的搜索高峰
LIBRARY_DAILY_HOUR=4

# ===== 反馈 / 求资源 =====
# 和埋点共用 backend/data/analytics.db 里的 feedback 表。
# 关掉不影响埋点，反之亦然。
FEEDBACK_ENABLED=true
# 单 IP 十分钟提交上限。只对通过校验的提交计数
FEEDBACK_RATE_PER_10MIN=5

# ===== 链接存活检测 =====
# 搜索返回后异步探活（夸克/UC/阿里/123；百度需带提取码），结果落
# backend/data/analytics.db 的 link_check 表，卡片上标「已失效/需提取码」。
# 打的是各网盘匿名接口，不占转存账号。关掉只影响标记，不影响搜索。
LINK_CHECK_ENABLED=true
# 并发线程数。别调大：匿名接口没配额说明，打急了会被当爬虫
LINK_CHECK_WORKERS=3
# 单条超时秒数（连接超时固定 4 秒）
LINK_CHECK_TIMEOUT=8
# 每次搜索最多检多少条（只检第一页）
LINK_CHECK_PER_PAGE=20
# 确认失效的是否从结果里摘掉。排查误判时先关这个，别关整个检测
LINK_CHECK_HIDE_BAD=true

# ===== 看板口令 =====
# 访问 /admin 看数据要输这个口令。留空时只有本机能看（走 Nginx 反代后等于谁都进不去）。
# 部署到公网必须设一个，建议 16 位以上随机串。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(18))"
ADMIN_TOKEN=

# ===== QQ 群采集（AstrBot + NapCat）=====
# 监听指定群里群主/管理员发的网盘分享，提取链接和标题后入库。
# 入口是 POST /api/ingest/qq，插件叫 astrbot_plugin_pantrace（采集侧从 v1.1.0 起）。
#
# 令牌单独一份，别复用 ADMIN_TOKEN：AstrBot 可能跑在另一台机器或别人的容器里，
# 不该让它拿着能改后台配置、能删订阅的那个口令。
# 留空会回退用 ADMIN_TOKEN；两个都空则只允许本机（127.0.0.1）调用。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
QQ_INGEST_ENABLED=true
QQ_INGEST_TOKEN=

# 单批消息上限。插件是攒批发（1.5 秒一批），正常几条到几十条。
# 超量几乎只有一个原因：插件那边群白名单被留空了。
QQ_INGEST_MAX_BATCH=50

# ===== 点击时转存（链接不外露）=====
# 用户点开资源时，后端用下面这个账号把上游分享转存一份，再把我们名下的
# 分享链接给他。关掉则恢复成直接给上游原始链接。
MIRROR_ENABLED=true

# 夸克 PC 网页版登录 cookie。抓法：浏览器登录 pan.quark.cn → F12 → Network
# → 任意 /1/clouddrive/ 请求 → 复制整条 Cookie 请求头。
# 至少要含 __pus / __puus；失效后所有点击都会回退到原链接，需要在后台换。
MIRROR_QUARK_COOKIE=

# 单条资源允许转存的最大体积（GB）。0 = 不限制（当前默认）。
# 填正数才启用闸门；一旦启用，超过的资源不转、直接给上游原链接。
# 放开的前提是账号空间够：容量满了以后所有转存都会失败并回退，且失败结果
# 会缓存 MIRROR_FAIL_TTL 秒，那段时间里换账号也不会重试。
MIRROR_MAX_GB=0

# 给用户的链接保留多少分钟。到点回收源文件，分享随之失效，再点会重新转存。
# 竞品是 25–30 分钟；比这短会让用户来不及转存，比这长空间占用和失效可控性都会变差。
# 分享本身按下面的 MIRROR_SHARE_HOURS 建（默认 1 天），这个值必须比它短：
# 它是删文件造出来的截止时间。
MIRROR_LINK_MINUTES=30

# 转存引流水印：转存时在落点目录里额外建一个空文件夹，名字就是这个值，
# 随资源一起进分享、一起给用户看到，30 分钟回收删 fids 时一起删掉。
# 目的是让用户把资源转到自己网盘时，目录里带着我们的网址，形成二次传播。
# 留空 = 关闭（不建文件夹、零额外请求）。夸克/UC、迅雷、百度支持建目录，其余盘跳过。
MIRROR_WATERMARK_NAME=资源搜索网址panseek.xyz

# 分享**本身**的有效期（小时，24～168 即 1～7 天）。这是安全网：回收任务没跑时靠它自己到期。
# 主闸门是上面的 MIRROR_LINK_MINUTES（删源文件造出来的截止时间），两者不能倒过来——
# 窗口必须短于分享有效期，否则回收还没跑、链接先自己到期了。
# **不要填 0**：百度 period=0 就是永久分享，回收失灵时资源会永久挂在账号上。
MIRROR_SHARE_HOURS=24

# 失败结果缓存秒数（避免每个点击都去打一次接口）与转存最小间隔（防网盘风控，别调小）
MIRROR_FAIL_TTL=600
MIRROR_MIN_INTERVAL=3

# /go/ 跳转 token 的签名密钥。留空则由 API_KEY 派生（重启不变）。
# 换掉它 = 已发出的旧链接全部失效（会回退到原链接，不会 404）。
MIRROR_SECRET=

# 转存失败是否回退到上游原始链接。false 则提示「资源暂不可用」
MIRROR_FALLBACK=true

# ===== 转存的广告清理 =====
# 源分享里常夹带「加群领福利」这类引流附件。处理分两级，开关只控制第二级：
#
#   一级（MIRROR_AD_PRESKIP，默认开）：转存**之前**就把顶层广告附件从待转清单里
#     摘掉。share_info 已经把文件名拿到手里了，这时候拦下来，文件根本不进网盘——
#     不用删、不占容量、不进回收站，也不额外发一个请求。
#   二级（MIRROR_AD_FILTER，默认关）：转存**之后**，后台线程再往目录里翻两层补一刀，
#     只删文件不删目录。它跑在独立线程里，不占用户从点击到拿到链接的时间。
#
# 判据是「三条全中」，缺一条就放过（宁可漏删不可误杀）：
#   名字命中关键词 + 附件型后缀 + 体积小于 MIRROR_AD_MAX_MB
# 附件型后缀只认 txt/url/html/ini 和图片；图片额外要求**文件名主干正好等于**
# 某个拦截词——"微信图片_20240101.jpg" 这种默认名会命中"微信"，不设这道闸会
# 一次删掉用户几百张图。目录永不判广告；视频/压缩包/文档即使名字带词也不动。
#
# 这些值都能在后台「广告过滤」面板改，改完立即生效，不用重启。面板里还有个
# 「试一个文件名」的试算框，走的是线上同一套判据——配完词先在那儿试。
#
# 一级默认生效——它不会删任何正片，只是少转几个引流附件，而且要出错能立刻
# 用 MIRROR_AD_PRESKIP=false 关掉。二级默认关，先观察再开。
# 观察方式：grep 日志里的「转存前跳过」和「目录内删掉」，看点名的是不是广告。
MIRROR_AD_PRESKIP=true
MIRROR_AD_FILTER=false
# 逗号分隔，只匹配**文件名**（不匹配路径）。这里刻意没有「广告」「推广」——
# 「广告设计素材」这类正片名会被误伤，真正的引流附件都带「公众号/加群」。
MIRROR_AD_KEYWORDS=微信,公众号,加群,进群,福利,防失联,更多资源,QQ群
# 二级清理往下探几层：1 = 只看转存内容的直接子项，2 = 再进一层子目录
MIRROR_AD_DEPTH=2
# 判定广告的体积上限（MB）。超过这个体积的附件一律不判——正片最低也有几十 MB，
# 2MB 足够挡住 txt / 单张图片这类引流附件。0 = 不限体积
MIRROR_AD_MAX_MB=2

# ===== 违规分享巡检 =====
# 我们转存的内容被判违规后，分享条目会挂在账号上，代价是限流甚至封号。
# 删文件撤不掉它（分享还在），必须调撤销接口。只对实现了该接口的网盘生效
#（目前是夸克/UC），其他平台自动跳过。
MIRROR_VIOLATED_AUTO=true
# 巡检间隔（分钟）。竞品是 5 分钟；违规判定本身滞后，30 分钟够用，
# 也不会把「我的分享」列表接口刷到风控。
MIRROR_VIOLATED_MINUTES=30
